{
  "name": "aubade",
  "version": "0.1.0",
  "description": "A three-minute, voice-narrated morning aubade for solo operators. Audio-first. Local-first. Literary.",
  "type": "module",
  "bin": {
    "aubade": "bin/aubade.js"
  },
  "scripts": {
    "start": "node bin/aubade.js",
    "dry": "node bin/aubade.js --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "landing": "open landing/index.html || start landing/index.html"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "morning",
    "routine",
    "voice",
    "tts",
    "aubade",
    "cli",
    "ink",
    "audio",
    "solo-dev",
    "productivity"
  ],
  "author": "Tyler Eveland <j.tyler.eveland@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evilander/aubade.git"
  },
  "homepage": "https://aubade.dev",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "better-sqlite3": "^11.5.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "gradient-string": "^3.0.0",
    "ink": "^5.0.1",
    "openai": "^4.68.0",
    "react": "^18.3.1",
    "suncalc": "^1.9.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "vitest": "^2.1.4"
  }
}
