# Aubade configuration
# Copy to .env and fill in. Only the LLM key is required.

# --- LLM (required, choose one) ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=sk-...   # fallback if no Anthropic key

# --- TTS (optional) ---
# Default is OpenAI TTS if OPENAI_API_KEY is set.
# Set AUBADE_TTS=kokoro to run fully offline with local Kokoro.js (no API key).
AUBADE_TTS=openai
AUBADE_VOICE=nova

# --- Script (optional) ---
AUBADE_MODEL=claude-opus-4-7
AUBADE_DURATION_SECONDS=180

# --- Signal scanning (optional) ---
# Comma-separated roots to scan for git activity + recent projects.
# Defaults to your home directory if unset.
AUBADE_ROOTS=B:/projects,A:/ai
AUBADE_NOTES=

# --- Storage (optional) ---
# Where to keep the memory database and cached audio.
# Defaults to ~/.aubade
AUBADE_HOME=
